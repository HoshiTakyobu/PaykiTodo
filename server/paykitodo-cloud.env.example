PAYKITODO_CLOUD_HOST=127.0.0.1
PAYKITODO_CLOUD_PORT=18766
PAYKITODO_CLOUD_DB=/var/lib/paykitodo/cloud.sqlite3
PAYKITODO_ADMIN_USER=REPLACE_WITH_ADMIN_USERNAME
PAYKITODO_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
PAYKITODO_PASSWORD_PEPPER=REPLACE_WITH_LONG_RANDOM_SERVER_SECRET
# Optional Cloudflare Turnstile protection for account authentication.
# Keep the secret only in this server-side environment file, never in Git or the APK.
PAYKITODO_TURNSTILE_SITE_KEY=REPLACE_WITH_PUBLIC_SITE_KEY
PAYKITODO_TURNSTILE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET_KEY
# Comma-separated production hostnames returned by Cloudflare Siteverify.
# Do not include localhost or 127.0.0.1 in the production service environment.
PAYKITODO_TURNSTILE_ALLOWED_HOSTNAMES=paykitodo.example.com
