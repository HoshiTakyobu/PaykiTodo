# Copy this file outside the public repository and replace every placeholder
# before deployment. Keep the real hostname and certificate paths private.
server {
    listen 80;
    server_name YOUR_PRIVATE_HOSTNAME;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name YOUR_PRIVATE_HOSTNAME;

    ssl_certificate /etc/ssl/paykitodo/fullchain.pem;
    ssl_certificate_key /etc/ssl/paykitodo/privkey.pem;

    location ^~ /paykitodo-sync/ {
        proxy_pass http://127.0.0.1:36568/;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 30s;
        client_max_body_size 40m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
