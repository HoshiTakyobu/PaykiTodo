<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PaykiTodo</AssemblyName>
    <RootNamespace>PaykiTodo.Desktop</RootNamespace>
    <Version>1.17.14</Version>
    <AssemblyVersion>1.17.14.0</AssemblyVersion>
    <FileVersion>1.17.14.0</FileVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PaykiTodo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\app\src\main\assets\ai\report-system.txt" LogicalName="PaykiTodo.ReportSystem" />
    <EmbeddedResource Include="..\..\app\src\main\assets\ai\planning-system.txt" LogicalName="PaykiTodo.PlanningSystem" />
    <EmbeddedResource Include="update-public-key.txt" LogicalName="PaykiTodo.UpdatePublicKey" />
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\*.ico" />
    <Resource Include="..\..\docs\WINDOWS_USER_GUIDE.md" Link="Assets\WINDOWS_USER_GUIDE.md" />
    <Resource Include="..\..\app\src\main\res\font\payki_greeting.ttf" Link="Assets\payki_greeting.ttf" />
    <Resource Include="..\..\app\src\main\res\font\sarasa_ui_regular.ttf" Link="Assets\sarasa_ui_regular.ttf" />
    <Resource Include="..\..\app\src\main\res\font\sarasa_ui_semibold.ttf" Link="Assets\sarasa_ui_semibold.ttf" />
    <Content Include="..\..\app\src\main\assets\fonts\OFL-Sarasa.txt" Link="OFL-Sarasa.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
